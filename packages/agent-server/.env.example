# configuracion del servidor del agente. copiar como .env (que git ignora) y ajustar.
# todos los valores tienen un default razonable, este archivo solo los documenta.

# puerto y host donde escucha (0.0.0.0 = acepta conexiones de afuera, necesario al desplegar)
PORT=8787
HOST=0.0.0.0
# ruta del websocket: la widget se conecta a ws://localhost:8787/ws
WS_PATH=/ws

# cuanto vive una sesion sin actividad (ms) y cuantos mensajes recuerda
SESSION_TTL_MS=1800000
MAX_HISTORY_MESSAGES=30

# cada cuantos ms se manda un snapshot del streaming a la widget
STREAM_THROTTLE_MS=50
