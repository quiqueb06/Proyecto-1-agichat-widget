# configuracion del servidor del agente. copiar como .env (que git ignora) y ajustar.
# todos los valores tienen un default razonable, este archivo solo los documenta.

# puerto y host donde escucha (0.0.0.0 = acepta conexiones de afuera, necesario al desplegar)
PORT=8787
HOST=0.0.0.0
# ruta del websocket: la widget se conecta a ws://localhost:8787/ws
WS_PATH=/ws

# cuanto vive una sesion sin actividad (ms) y cuantos mensajes recuerda
SESSION_TTL_MS=1800000
MAX_HISTORY_MESSAGES=30

# cada cuantos ms se manda un snapshot del streaming a la widget
STREAM_THROTTLE_MS=50

# ---------- limites (seguridad y cuidar las cuotas gratis) ----------

# paginas que pueden conectarse (cabecera Origin), separadas por comas. "*" = cualquiera.
# al desplegar hay que agregar la url de la demo, ej. https://quiqueb06.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# conexiones abiertas al mismo tiempo en todo el servidor
MAX_CONNECTIONS=100
# tamano maximo de un frame en bytes (si se pasa, se cierra la conexion)
MAX_PAYLOAD_BYTES=16384
# largo maximo del texto de un mensaje
MAX_MESSAGE_CHARS=2000
# cuantos mensajes por ventana puede mandar cada usuario (10 por minuto)
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_MS=60000
# mensajes que pueden esperar turno ademas del que se esta respondiendo
MAX_QUEUED_MESSAGES=2
# cada cuantos ms se revisa que los clientes sigan vivos (ping/pong)
HEARTBEAT_MS=30000
