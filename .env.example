# variables de la demo de la widget. copiar como .env.local (que git ignora) y ajustar.

# url del websocket del servidor del agente (packages/agent-server).
# si se deja vacia o se borra, la demo usa el mock como en el proyecto 1
VITE_AGENT_URL=ws://localhost:8787/ws

# ---------- Groq / LLM ----------

# crear en https://console.groq.com
# nunca commitear la key real
GROQ_API_KEY=

# modelo configurable
GROQ_MODEL=openai/gpt-oss-120b

GROQ_BASE_URL=https://api.groq.com/openai/v1
